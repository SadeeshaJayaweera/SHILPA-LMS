# ==============================================================================
# SHILPA LMS — Production Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env ON PRODUCTION DEPLOYMENT AND POPULATE SECURE SECRETS.
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

APP_NAME="SHILPA LMS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://lms.shilpa.edu

# Relational Database (MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shilpa_production
DB_USERNAME=shilpa_app
DB_PASSWORD=

# Session Security & Storage
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# High-Performance Caching
CACHE_DRIVER=file
CACHE_PREFIX=shilpa_cache_

# Reliable Background Queue
QUEUE_CONNECTION=database
QUEUE_MAX_ATTEMPTS=3

# Transactional Mail Services
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@shilpa.edu"
MAIL_FROM_NAME="SHILPA Learning Management"

# AI Tutor Service Integration
AI_TUTOR_ENABLED=true
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Storage & File Uploads
STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_MIME_TYPES="application/pdf,application/zip,image/jpeg,image/png"

# Security & Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_DECAY=60
