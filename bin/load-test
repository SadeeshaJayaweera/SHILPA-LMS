#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

$app = new \App\Core\Application(dirname(__DIR__));
$app->bootstrap();

$options = getopt('', ['requests::', 'endpoint::']);
$numRequests = max(10, min(1000, (int)($options['requests'] ?? 100)));
$endpoint = (string)($options['endpoint'] ?? '/');

echo "\033[1;36m=========================================\033[0m\n";
echo "\033[1;36m    SHILPA LMS SYNTHETIC LOAD BENCHMARK  \033[0m\n";
echo "\033[1;36m=========================================\033[0m\n";
echo "Target Endpoint: \033[33m{$endpoint}\033[0m\n";
echo "Total Requests:  \033[33m{$numRequests}\033[0m\n\n";

$latencies = [];
$successCount = 0;
$startTime = microtime(true);

for ($i = 0; $i < $numRequests; $i++) {
    $reqStart = microtime(true);
    $request = new \App\Core\Request('GET', $endpoint, [], [], [], [
        'REQUEST_METHOD' => 'GET',
        'REQUEST_URI' => $endpoint,
    ]);
    
    $response = $app->handle($request);
    $latencyMs = (microtime(true) - $reqStart) * 1000;
    $latencies[] = $latencyMs;

    if ($response->getStatusCode() < 400) {
        $successCount++;
    }
}

$totalTime = microtime(true) - $startTime;
$rps = round($numRequests / max($totalTime, 0.001), 2);

sort($latencies);
$min = round($latencies[0], 2);
$max = round(end($latencies), 2);
$avg = round(array_sum($latencies) / count($latencies), 2);
$p50 = round($latencies[(int)(count($latencies) * 0.50)], 2);
$p95 = round($latencies[(int)(count($latencies) * 0.95)], 2);
$p99 = round($latencies[(int)(count($latencies) * 0.99)], 2);
$memoryMb = round(memory_get_peak_usage(true) / 1024 / 1024, 2);

echo "\033[1;32mBenchmark Results:\033[0m\n";
echo "  Total Wall Time:    " . round($totalTime, 4) . "s\n";
echo "  Throughput (RPS):   \033[1;32m{$rps} req/sec\033[0m\n";
echo "  Success Rate:       {$successCount}/{$numRequests} (" . round(($successCount / $numRequests) * 100) . "%)\n";
echo "  Min Latency:        {$min} ms\n";
echo "  Avg Latency:        {$avg} ms\n";
echo "  p50 Median Latency: \033[32m{$p50} ms\033[0m\n";
echo "  p95 Latency:        {$p95} ms\n";
echo "  p99 Latency:        {$p99} ms\n";
echo "  Max Latency:        {$max} ms\n";
echo "  Peak Memory:        {$memoryMb} MB\n\n";

if ($successCount === $numRequests) {
    echo "\033[1;32m✓ LOAD BENCHMARK PASSED AT ENTERPRISE GRADE READINESS\033[0m\n";
} else {
    echo "\033[1;31m✗ SOME REQUESTS FAILED DURING LOAD TESTING\033[0m\n";
    exit(1);
}
